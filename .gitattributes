# 统一换行符，避免 Windows 检出时把 LF 改成 CRLF 造成全文件 diff。
* text=auto eol=lf

# 二进制文件不参与文本处理。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary

# 这些文件在 diff 和语言统计里不显示。
package-lock.json linguist-generated=true
pnpm-lock.yaml linguist-generated=true
CHANGELOG.md merge=union
