{
  "name": "@star-12-bytedance/dsh-llm-profile",
  "version": "0.1.0",
  "description": "Per-call LLM token attribution for DeepSeek Harness (DSH): context size, cache-hit rate, internal-call overhead, and the most expensive calls. Answers \"which step burned the tokens\" — the question a total-cost meter cannot.",
  "license": "MIT",
  "author": {
    "name": "star-12-Bytedance",
    "email": "niu071112@qq.com",
